# Directory that contains stats.json, outline.json, receiver.json, and aircraft.json.
TAR1090_BASE_URL=http://tar1090.local/data
TAR1090_TIMEOUT_SEC=10
# Used only when receiver.json has no lat/lon.
# TAR1090_LAT=
# TAR1090_LON=
POLL_INTERVAL_SEC=20

# MQTT
MQTT_BROKER=localhost
MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
MQTT_CLIENT_ID=tar1090-ha-bridge
MQTT_HA_PREFIX=homeassistant

# Home Assistant device
HA_DEVICE_ID_PREFIX=tar1090
HA_DEVICE_NAME=tar1090
